{
  "name": "dsh-hoploom",
  "version": "0.3.1",
  "description": "Hoploom for DeepSeek Harness: local SSH inventory, host context and explicitly enabled remote operations, with credentials kept in the OS vault.",
  "type": "module",
  "license": "MIT",
  "author": "xiayh0107",
  "homepage": "https://github.com/xiayh0107/hoploom/tree/main/dsh-hoploom",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiayh0107/hoploom.git",
    "directory": "dsh-hoploom"
  },
  "bugs": {
    "url": "https://github.com/xiayh0107/hoploom/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "backend",
    "python/*.py",
    "python/_hoploom_packaging/*.py",
    "python/_hoploom_packaging/LICENSE*",
    "python/_hoploom_packaging/README.md"
  ],
  "icon": "icon.svg",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis-plugin",
    "hoploom",
    "ssh",
    "mcp",
    "keychain"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.5": "compatible",
        "0.2.2-rc.1": "compatible"
      }
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && npm test",
    "prepack": "npm run build && npm run check:backend",
    "check:backend": "node scripts/check-backend.mjs",
    "build:backend": "node scripts/build-backend.mjs"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "fflate": "^0.8.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-mcp-client": ">=0.2.1-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.1-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.1-rc.5 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.3.0-0",
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.19.0",
    "typescript": "5.9.3",
    "esbuild": "^0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "^18.3.27",
    "jsdom": "^26.1.0"
  }
}
